      "code": "heart_rate",
      "label": "Heart rate",
      "unit": "bpm",
      "value_type": "numeric",
      "origin": "observed",
      "bounds": { "min": 20, "max": 250 },
      "limits": [
        { "level": "critical", "op": "<=", "value": 40, "source": "NEWS2 (Royal College of Physicians, 2017): single-parameter score 3" },
        { "level": "critical", "op": ">=", "value": 131, "source": "NEWS2 (Royal College of Physicians, 2017): single-parameter score 3" },
        { "level": "watch", "op": ">=", "value": 111, "max": 130, "source": "NEWS2 (Royal College of Physicians, 2017): single-parameter score 2" }
      ],
      "limit_source": "NEWS2 (Royal College of Physicians, 2017): parameter score 3 is critical, 2 is watch.",
      "phase_offsets": {},
      "sd_floor": 3,
      "min_baseline_readings": 5,
      "body_system": "cardiovascular",
      "hazards": ["altered_gravity", "isolation_confinement"],
      "guidance_key": "measure-heart-rate",
      "aliases": ["heart_rate_bpm", "hr_bpm", "pulse_bpm"]
